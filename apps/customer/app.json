{
  "expo": {
    "name": "MedFind",
    "slug": "medfind-customer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.medfind.customer"
    },
    "android": {
      "package": "com.medfind.customer",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "MedFind uses your location to show pharmacies near you that have your medicine."
        }
      ]
    ],
    "scheme": "medfind",
    "experiments": {
      "typedRoutes": false
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "326041d1-e167-4ce6-8b09-0a59897fd526"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/326041d1-e167-4ce6-8b09-0a59897fd526"
    }
  }
}
