{
  "name": "medfind",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "customer": "pnpm --filter customer start",
    "pharmacy": "pnpm --filter pharmacy dev",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local > packages/core/src/database.types.ts"
  },
  "devDependencies": {
    "supabase": "^3.2.0",
    "turbo": "^2.11.13"
  },
  "engines": {
    "node": ">=22.18"
  }
}
