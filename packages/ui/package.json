    },
    "react-native-svg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "dependencies": {
    "@medfind/core": "workspace:*"
  }
}
