{
  "name": "@medfind/ui",
  "version": "0.1.0",
  "private": true,
  "description": "MedFind shared theme (colours, text styles, spacing, radii, icons) and components for the customer and pharmacy apps",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./native": "./src/native/index.ts",
    "./web": "./src/web/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-svg": "*"
  },
  "peerDependenciesMeta": {
    "react-native": {
